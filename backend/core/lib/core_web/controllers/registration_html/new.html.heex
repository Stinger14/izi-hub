<div class="min-h-screen">
  <header class="border-b border-[color:var(--hub-border)]">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
      <div>
        <p class="font-display text-lg text-[var(--hub-accent-2)]">Sign up</p>
      </div>
      <a href={~p"/hub"} class="btn btn-secondary btn-sm">Back to hub</a>
    </div>
  </header>

  <main class="mx-auto flex min-h-[calc(100vh-6rem)] w-full max-w-md items-center px-6 py-12">
    <div class="hub-glass w-full rounded-2xl p-6">
      <div class="mb-6">
        <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--hub-accent-2)]">
          Authentication
        </p>
        <h2 class="font-display mt-2 text-2xl text-[var(--hub-text)]">Create account</h2>
        <p class="mt-1 text-sm text-[var(--hub-muted)]">
          Enter your email and we will take you to password setup.
        </p>
      </div>

      <%= if @errors != [] do %>
        <div
          role="alert"
          class={[
            "mb-4 rounded-xl border border-[color:var(--tone-expense)]/30 px-3 py-2 text-xs",
            CoreWeb.FinanceComponents.tone_class("expense", :soft)
          ]}
        >
          <ul class="space-y-1">
            <%= for error <- @errors do %>
              <li><%= error %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <.form for={%{}} as={:user} action={~p"/signup"} method="post" class="space-y-4">
        <div>
          <label for="user_email" class="mb-1 block text-sm font-medium text-[var(--hub-text)]">Email</label>
          <input
            id="user_email"
            name="user[email]"
            type="email"
            value={Map.get(@form_data, "email", "")}
            required
            autocomplete="email"
            class="w-full rounded-lg border border-[color:var(--hub-border)] bg-[var(--hub-surface)] px-3 py-2 text-sm text-[var(--hub-text)] transition focus:border-[color:var(--hub-accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--hub-accent)]/30"
          />
        </div>

        <button type="submit" class="btn btn-primary btn-glow w-full">Continue</button>
      </.form>

      <p class="mt-4 text-xs text-[var(--hub-muted)]">
        Already have an account?
        <a href={~p"/login"} class="font-semibold text-[var(--hub-secondary)] transition hover:text-[var(--hub-accent-2)]">Sign in</a>
      </p>
    </div>
  </main>
</div>
