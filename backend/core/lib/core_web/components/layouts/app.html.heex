<section class="min-h-screen bg-white text-slate-900">
  <% current_scope = Map.get(assigns, :current_scope) %>
  <div class="flex min-h-screen flex-col">
    <header class="relative z-40 border-b border-purple-100/70 bg-white/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href={~p"/hub"} class="text-sm font-semibold tracking-tight text-purple-600">IziHub</a>

        <div class="flex items-center gap-2">
          <%= if current_scope do %>
            <a href={~p"/office"} class="btn btn-secondary btn-xs">Office</a>
          <% end %>

          <%= if current_scope && current_scope.user.role == "admin" do %>
            <a href={~p"/admin"} class="btn btn-secondary btn-xs">Admin</a>
          <% end %>

          <%= if current_scope do %>
            <span
              class="inline-flex items-center gap-1.5 rounded-[14px] border px-2.5 py-1.5 text-xs font-semibold leading-[1.2] text-purple-600"
              style="border-color: var(--btn-secondary-border); background: var(--btn-secondary-bg);"
            >
              <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
              <%= current_scope.user.username || current_scope.user.email %>
            </span>
            <.form for={%{}} as={:logout} action={~p"/logout"} method="delete">
              <button type="submit" class="btn btn-secondary btn-xs">Logout</button>
            </.form>
          <% end %>
        </div>
      </div>
    </header>

    <div class="flex-1">
      <%= if Map.has_key?(assigns, :inner_block) do %>
        <%= render_slot(@inner_block) %>
      <% else %>
        <%= @inner_content %>
      <% end %>
    </div>
    <footer class="border-t border-purple-100/70 bg-white/80 px-4 py-2 text-[11px] font-medium text-slate-400">
      <div class="mx-auto max-w-6xl">
        <div class="flex min-h-6 items-center justify-center gap-3">
          <span class="whitespace-nowrap text-[11px] font-medium text-slate-400">IziHub v0.9.0</span>
          <span class="fx-tech-chip whitespace-nowrap">Built with LiveView</span>
        </div>
      </div>
    </footer>
  </div>
</section>
