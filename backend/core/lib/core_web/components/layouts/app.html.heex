<% current_scope = Map.get(assigns, :current_scope) %>
<%!-- Optional, so controller-rendered pages can skip them. The page's slots
     are rendered here and handed to workspace_nav as its own slots: passing
     the slot entries on as an attribute would stop them re-rendering when
     the page's assigns change. --%>
<% workspace = Map.get(assigns, :workspace) %>
<% workspace_tools = Map.get(assigns, :workspace_tools, []) %>
<% workspace_panel = Map.get(assigns, :workspace_panel, []) %>
<section class="hub-shell min-h-screen">
  <div class="flex min-h-screen flex-col">
    <header id="site-header" class="sticky top-0 z-40 px-3 pt-2 sm:px-4">
      <%!-- The wordmark sits outside the glass strip, on the page itself, so
           it reads as the brand and the strip as navigation. Signed-in phones get
           the short mark to leave the strip room for every app. --%>
      <div class="mx-auto flex max-w-6xl items-center gap-2 sm:gap-4">
        <a
          href={if current_scope, do: ~p"/hub", else: ~p"/welcome"}
          id="header-logo"
          aria-label="IziHub"
          class="font-display shrink-0 text-lg text-[var(--hub-secondary)] transition hover:text-[var(--hub-accent-2)] sm:text-xl"
        >
          <%= if current_scope do %>
            <span class="sm:hidden">Izi</span><span class="hidden sm:inline">IziHub</span>
          <% else %>
            IziHub
          <% end %>
        </a>
        <div
          id="workspace-bar"
          class={[
            "hub-glass flex min-w-0 items-center gap-1.5 rounded-2xl p-1.5 sm:gap-2 sm:p-2 shadow-[0_16px_32px_-20px_var(--hub-shadow)]",
            if(current_scope, do: "flex-1", else: "ml-auto")
          ]}
        >
          <%= if current_scope do %>
            <.workspace_nav current_scope={current_scope} active={workspace}>
              <:tools :if={workspace_tools != []}><%= render_slot(workspace_tools) %></:tools>
            </.workspace_nav>
            <.account_menu user={current_scope.user} />
          <% else %>
            <a href={~p"/login"} id="header-sign-in" class="btn btn-primary btn-xs">Sign in</a>
          <% end %>
        </div>
      </div>
      <div class="mx-auto max-w-6xl"><%= render_slot(workspace_panel) %></div>
    </header>

    <.flash_group flash={Map.get(assigns, :flash, %{})} />

    <div class="flex-1">
      <%= if Map.has_key?(assigns, :inner_block) do %>
        <%= render_slot(@inner_block) %>
      <% else %>
        <%= @inner_content %>
      <% end %>
    </div>
    <footer class="border-t border-[color:var(--hub-border)] bg-[color:var(--hub-card)]/60 px-4 py-2 text-[11px] font-medium text-[var(--hub-muted)]">
      <div class="mx-auto max-w-6xl">
        <div class="flex min-h-6 items-center justify-center gap-3">
          <span class="whitespace-nowrap text-[11px] font-medium">IziHub v<%= Application.spec(:core, :vsn) %></span>
          <span class="fx-tech-chip whitespace-nowrap">Built with LiveView</span>
        </div>
      </div>
    </footer>
  </div>
</section>
