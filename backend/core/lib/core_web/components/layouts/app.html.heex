<section class="min-h-screen bg-white text-slate-900">
  <div class="flex min-h-screen flex-col">
    <div class="flex-1">
      <%= render_slot(@inner_block) %>
    </div>
    <footer class="border-t border-purple-100/70 bg-white/80 px-4 py-2 text-center text-[11px] font-medium text-slate-400">
      IziHub v<%= app_version() %>
    </footer>
  </div>
</section>
