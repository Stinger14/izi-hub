<section class="min-h-screen bg-white text-slate-900">
  <div class="flex min-h-screen flex-col">
    <div class="flex-1">
      <%= render_slot(@inner_block) %>
    </div>
    <footer class="border-t border-purple-100/70 bg-white/80 px-4 py-2 text-[11px] font-medium text-slate-400">
      <div class="mx-auto max-w-6xl">
        <div class="flex min-h-6 items-center justify-end gap-3">
          <span class="whitespace-nowrap text-[11px] font-medium text-slate-400">IziHub v0.2.1</span>
          <span class="fx-tech-chip whitespace-nowrap">Built with LiveView</span>
        </div>
      </div>
    </footer>
  </div>
</section>
